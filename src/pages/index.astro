---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProfileHeader from "../components/ProfileHeader.astro";
import TimelineList from "../components/TimelineList.astro";
import PostList from "../components/PostList.astro";
import { getCollection } from "astro:content";
import {
    PROFILE,
    LINKS,
    EXPERIENCES,
    TEACHING_SERVICE,
    EDUCATION,
} from "../consts";

const links = [
    LINKS.email,
    LINKS.github,
    LINKS.linkedin,
    LINKS.resume,
    LINKS.blog,
    // LINKS.projects,
];

// Recent posts
const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);
---

<SiteLayout title={PROFILE.name}>
    <ProfileHeader
        name={PROFILE.name}
        tagline={PROFILE.tagline}
        links={links}
    />

    <main>
        <section class="section">
            <h1 style="margin-bottom: 0.6rem;">{PROFILE.name}</h1>
            <p>
                I am a computer science student at the <a
                    href="https://www.ubc.ca/">University of British Columbia</a
                > and a research collaborator in the <a
                    href="https://vision.cs.ubc.ca/"
                    >Computer Vision lab</a
                > under 
                <a href="https://www.cs.ubc.ca/~sigal/">Professor Leonid Sigal</a>.

                I hold a bachelor's degree in Information Systems from <a
                    href="https://www.cmu.edu/"
                    >Carnegie Mellon University</a
                 >.
            </p>
            <p>
                My research currently centers on self-supervised representation learning
                for vision, working with the JEPA family of architectures to explore better
                pre-training strategies.
            </p>
            <p>
                In past internships, I've explored generative and analytics-focused NLP workflows
                for the banking and enterprise software sectors.
            </p>
            <p>
                I devote a good chunk of my time serving the UBC Computer Science community as VP Academic of the
                <a href="https://www.ubccsss.org/">UBC CSSS</a>,
                organizing events like the <a href="https://ubccsss.org/cssrc/">UBC Computer Science Student Research
                Conference</a>.
            </p>
            <p>
                Check out <b><a href="https://www.cs.ubc.ca/news/2026/03/cssrc">this article</a></b> covering how
                my team and I launched the inaugual conference in early 2026!
            </p>
        </section>

        <hr />

        <section class="section">
            <h2>Experience</h2>
            <TimelineList items={EXPERIENCES} />
        </section>

        <section class="section">
            <h2>Teaching & Service</h2>
            <TimelineList items={TEACHING_SERVICE} />
        </section>

        <section class="section">
            <h2>Education</h2>
            <TimelineList items={EDUCATION} />
        </section>

        <hr />

        <section class="section">
            <h2>Recent Posts</h2>
            <div style="margin-top: 0.625rem;">
                <PostList posts={posts} />
                <div style="margin-top: 0.625rem;">
                    <a href="/blog">All posts →</a>
                </div>
            </div>
        </section>
    </main>
</SiteLayout>
