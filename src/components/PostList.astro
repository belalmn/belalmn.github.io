---
import type { CollectionEntry } from "astro:content";

interface Props {
    posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const fmt = new Intl.DateTimeFormat("en-CA", {
    year: "numeric",
    month: "short",
    day: "2-digit",
});
---

{
    posts.length === 0 ? (
        <p class="meta">No posts yet. Check back soon.</p>
    ) : (
        <ul class="list">
            {posts.map((p) => (
                <li>
                    <a
                        href={`/blog/${p.slug}/`}
                        style="font-weight: 600; color: var(--text);"
                    >
                        {p.data.title}
                    </a>
                    <div class="meta">
                        {fmt.format(p.data.pubDate)}
                        {p.data.description ? ` · ${p.data.description}` : ""}
                    </div>
                </li>
            ))}
        </ul>
    )
}
